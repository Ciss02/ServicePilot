# Copiare i nomi in variabili d'ambiente locali e scegliere valori diversi e segreti.
# Ogni valore deve contenere almeno 12 caratteri. Non inserire credenziali reali qui.
SERVICEPILOT_DEMO_EMPLOYEE_PASSWORD=
SERVICEPILOT_DEMO_TECHNICIAN_PASSWORD=
SERVICEPILOT_DEMO_ADMIN_PASSWORD=

# In locale resta false. Impostare true quando il portale viene servito tramite HTTPS.
SERVICEPILOT_SECURE_COOKIES=false

# L'AI resta disattivata finché non viene scelta esplicitamente Gemini.
# Creare la chiave in Google AI Studio e conservarla soltanto nel file .env locale.
SERVICEPILOT_AI_PROVIDER=disabled
SERVICEPILOT_AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Limiti prudenti per evitare attese e tentativi eccessivi.
SERVICEPILOT_AI_TIMEOUT_SECONDS=15
SERVICEPILOT_AI_MAX_ATTEMPTS=2
SERVICEPILOT_AI_MAX_OUTPUT_TOKENS=1024

# Archivio locale dei documenti della knowledge base, sempre escluso da Git.
SERVICEPILOT_KNOWLEDGE_STORAGE_DIR=storage/knowledge

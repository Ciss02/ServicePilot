# Copiare i nomi in variabili d'ambiente locali e scegliere valori diversi e segreti.
# Ogni valore deve contenere almeno 12 caratteri. Non inserire credenziali reali qui.
SERVICEPILOT_DEMO_EMPLOYEE_PASSWORD=
SERVICEPILOT_DEMO_TECHNICIAN_PASSWORD=
SERVICEPILOT_DEMO_ADMIN_PASSWORD=

# In locale resta false. Impostare true quando il portale viene servito tramite HTTPS.
SERVICEPILOT_SECURE_COOKIES=false
